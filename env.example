APP_MODE=mock
APP_HOST=127.0.0.1
APP_PORT=8000
MOCK_PORT=8787
APP_NOW=2026-11-06T10:00:00+02:00
STATE_DIR=runtime
APP_INTERNAL_SECRET=
YEXT_BASE_URL=https://sbx-api.yextapis.com
YEXT_API_KEY=
YEXT_ENTITY_ID=
YEXT_API_VERSION=20261106
SANDBOX_SOURCE_ENTITY_ID=FI-D0001
ALLOW_SANDBOX_WRITES=false

# Preferred offline reply interpreter: fine-tuned Gemma 2 2B (GGUF, llama-cpp-python).
# Used automatically when the file exists; otherwise Gemini, otherwise local rules.
GEMMA_ENABLED=true
GEMMA_MODEL_PATH=runtime/models/gemma-2-2b-reply.gguf
GEMMA_TIMEOUT=4

# Optional server-side Gemini (fallback when no Gemma model file is present). No key is delivered to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLED=true
# Optional path to an existing private dotenv file (local use only).
GEMINI_ENV_FILE=
