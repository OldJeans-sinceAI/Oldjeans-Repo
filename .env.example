APP_MODE=mock
APP_HOST=127.0.0.1
APP_PORT=8000
MOCK_PORT=8787
APP_NOW=2026-11-06T10:00:00+02:00
STATE_DIR=runtime
APP_INTERNAL_SECRET=
YEXT_BASE_URL=https://sbx-api.yextapis.com
YEXT_API_KEY=
YEXT_ENTITY_ID=
YEXT_API_VERSION=20261106
SANDBOX_SOURCE_ENTITY_ID=FI-D0001
ALLOW_SANDBOX_WRITES=false

# Preferred offline reply interpreter: fine-tuned Gemma 2 2B (GGUF, llama-cpp-python).
# Used automatically when the file exists; otherwise Gemini, otherwise local rules.
GEMMA_ENABLED=true
GEMMA_MODEL_PATH=runtime/models/gemma-2-2b-reply.gguf
GEMMA_TIMEOUT=4
(.venv) risu@risu-HP-Laptop-14s-fq1xxx:~/Programs/Oldjeans-Repo$ # Snapshot both refs into two folders, then let VS Code diff the whole trees
rm -rf /tmp/oldjeans-old /tmp/oldjeans-new
git archive main         | tar -x -C /tmp/oldjeans-old --one-top-level
git archive origin/main  | tar -x -C /tmp/oldjeans-new --one-top-level

# whole-tree diff — every changed file appears in one multi-file tab
code --diff /tmp/oldjeans-old /tmp/oldjeans-new
tar: Cannot deduce top-level directory name; please set it explicitly with --one-top-level=DIR
Try 'tar --help' or 'tar --usage' for more information.
tar: Cannot deduce top-level directory name; please set it explicitly with --one-top-level=DIR
Try 'tar --help' or 'tar --usage' for more information.
